% =============================================================================
% beamerthememidcenturymodern.sty
% A mid-century modern Beamer template. Requires LuaLaTeX.
%
% COLOUR THEMES
%
%   Two built-in themes: DeepBlue (default) and Kraft.
%   Select in your preamble before \begin{document}:
%
%     \usepackage{beamerthememidcenturymodern}
%     \mcmTheme{Kraft}
%
% FONTS
%
%   Body: TeX Gyre Heros — Helvetica (Miedinger, 1957).
%   Titles: TeX Gyre Adventor — Avant Garde Gothic (Lubalin, 1970), letterspaced.
%
%   Both ship with TeX Live, so the theme renders identically everywhere and
%   needs no font installed by the user.
%
%   Override in your preamble after loading the template:
%     \setsansfont{Font Name}
%     \renewfontfamily\mcmTitleFont{Font Name}
%
% =============================================================================
\ProvidesPackage{beamerthememidcenturymodern}[2025/01/01 Mid-Century Modern Beamer Template]

\setbeamersize{text margin left=2em, text margin right=2em}

\RequirePackage{calc}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{fontspec}
\RequirePackage{hyperref}
\RequirePackage{ragged2e}
\defaultfontfeatures{Ligatures=TeX}

\setbeamertemplate{frametitle continuation}{}

% ---------------------------------------------------------------------------
% FONTS
% ---------------------------------------------------------------------------
% \if@mcmfontspec records whether the fonts below really are fontspec
% families: \addfontfeature (used for the letterspaced title-page capitals)
% only works on a font fontspec itself selected.
\newif\if@mcmfontspec
\IfFontExistsTF{TeX Gyre Heros}{%
  \setsansfont{TeX Gyre Heros}\@mcmfontspectrue
}{%
  \IfFontExistsTF{Helvetica}{\setsansfont{Helvetica}\@mcmfontspectrue}{}%
}
\renewcommand{\familydefault}{\sfdefault}

% Titles are letterspaced: Avant Garde was drawn for wide-set capitals, and the
% uppercase frame titles/title page need the extra fit. LetterSpace is a
% percentage of the font size, so it scales with the title auto-fit on its own.
\IfFontExistsTF{TeX Gyre Adventor}{%
  \newfontfamily\mcmTitleFont{TeX Gyre Adventor}[LetterSpace=6.0]%
  \@mcmfontspectrue
}{%
  \let\mcmTitleFont\sffamily
}

% Secondary title-page text (subtitle, author, institute, date) is set in
% widely letterspaced capitals -- the mid-century way of ranking a title block
% by tracking rather than by size or tint. The tracked font is derived from
% \mcmTitleFont at use time, so a user who redefines the title font gets the
% tracked variant of their own font too. Disable with \mcmTitleMetaCapsfalse.
\newcommand{\mcmTitleMetaTracking}{14.0}
\newcommand{\mcm@metatrack}{\addfontfeature{LetterSpace=\mcmTitleMetaTracking}}
\if@mcmfontspec\else\let\mcm@metatrack\relax\fi
\newcommand{\mcmTitleMetaFont}{\mcmTitleFont\mcm@metatrack}
\newif\ifmcmTitleMetaCaps
\mcmTitleMetaCapstrue
\newcommand{\mcmTitleMetaFormat}[1]{%
  \ifmcmTitleMetaCaps{\mcmTitleMetaFont\mcm@upper{#1}}\else#1\fi}

% \mcm@upper: \MakeUppercase for a beamer title field.  Beamer prefixes
% \insertauthor and \insertinstitute with two \def's that give \inst and
% \and the meaning that field wants (\quad between authors, a line break
% between institutes).  The case changer expands its argument and cannot
% expand a \def, which raises three errors per title page and mangles the
% separators.  So: expand the field once, run those \def's here -- as
% \protected macros, so the case changer copies \inst/\and through
% untouched instead of expanding \quad or \\[1em] into uppercased garbage --
% and hand it only what is left, the text itself.
\long\def\mcm@upper#1{\begingroup\expandafter\mcm@stripdefs#1\mcm@stop}
\long\def\mcm@stripdefs{\@ifnextchar\def{\mcm@takedef}{\mcm@upperrest}}
\long\def\mcm@takedef\def#1#2{\protected\def#1{#2}\mcm@stripdefs}
\long\def\mcm@upperrest#1\mcm@stop{\MakeUppercase{#1}\endgroup}

% Uppercase titles (default on). Disable: \mcmTitleUppercasefalse
\newif\ifmcmTitleUppercase
\mcmTitleUppercasetrue

% Extra word spacing on the title page (default 0.5em)
\newlength{\mcmTitleWordSpacing}
\setlength{\mcmTitleWordSpacing}{0.5em}

% Helper: apply title font + optional uppercase
\newcommand{\mcmTitleFormat}[1]{%
  {\mcmTitleFont
   \ifmcmTitleUppercase\MakeUppercase{#1}\else#1\fi}%
}

\mode<presentation>{
  \usetheme{default}
  \usefonttheme{professionalfonts}
  \setbeamertemplate{navigation symbols}{}
}

