\setbeamercolor{normal text}{fg=mcmBlack, bg=mcmBg}
\setbeamercolor{structure}{fg=mcmDeepGreen}
\setbeamercolor{block body}{fg=mcmBlack, bg=mcmBg}
\setbeamercolor{bibliography entry title}{fg=mcmBlack}
\setbeamercolor{bibliography entry location}{fg=mcmBlack}
\setbeamercolor{bibliography entry note}{fg=mcmBlack}

% Bullet colour macro (must be defined before first \mcmTheme call)
\newcommand{\mcmBulletColor}{mcmPip}

% Apply default theme
\mcmTheme{DeepBlue}

% ---------------------------------------------------------------------------
% FONT ASSIGNMENTS
% ---------------------------------------------------------------------------
\setbeamerfont{title}{size={\fontsize{21}{23}}, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\mdseries}
\setbeamerfont{author}{size=\Large}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\scriptsize}
\setbeamerfont{frametitle}{size=\large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small, series=\mdseries}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{section in toc}{size=\normalsize, series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small}

% ---------------------------------------------------------------------------
% FRAME TITLE — coloured band with accent line below, title + optional subtitle
%
% Knobs
%   \mcmFrameTitleLeft    0.35cm  left padding of the band
%   \mcmFrameTitleRight   0.40cm  right padding
%   \mcmFrameTitleHeight  1.10cm  height of a one-line band; the white above
%                                 and below the text is derived from it, so
%                                 this one length sets the whole band
%   \mcmFrameSubtitleSep  0.03cm  title to subtitle, on top of the line's own
%                                 baselineskip: enough to tie the two lines
%                                 together, not enough to separate them
%   \mcmFrameTitleRise    0pt     manual nudge: the text sits that much higher
%                                 in the band. The optical correction a line
%                                 of capitals needs is applied automatically
%                                 (see the template), this is only for taste
%   \mcmFrameSubtitleSink 1pt     how much lower than geometric centre a
%                                 title+subtitle pair sits. Two reasons, both
%                                 optical: the pair is top-heavy (bold
%                                 capitals over a small light line), and the
%                                 accent rule adds 0.8pt of visible band
%                                 below. Centred by measurement it reads as
%                                 high — Jules, 2026-09-01
%   \mcmFrameSubtitleGrow 0.30cm  all the height a one-line subtitle adds to
%                                 the band. The subtitle's own line rides in
%                                 the white a one-line band already carries;
%                                 this is only what has to be given back so
%                                 the two lines are not pressed against the
%                                 edges. At 0 the band is strictly unchanged
%                                 but the worst case (an accented capital over
%                                 a line of descenders) is left with 1.7pt of
%                                 white top and bottom, which reads as glued;
%                                 0.30cm leaves 5.5pt there and 7.2pt in the
%                                 ordinary case, against the 9.6pt of a
%                                 one-line band.
%   \setbeamerfont/color{framesubtitle}, \mcmFrameSubtitleFormat
%
% The band measures its content and grows: a `\framesubtitle`, or a title long
% enough to wrap, used to be typeset into a `\vbox to 1.10cm` and simply ran
% out through the bottom edge and across the accent line. The line is drawn at
% the band's real height, so it follows, and the body starts below it.
%
% A one-line title comes out at exactly \mcmFrameTitleHeight with its ink where
% the theme has always put it — existing decks and screenshots do not move.
%
% Three traps here:
%
% 1. The height is measured on a *strutted* copy of the content and the
%    unstrutted copy is what gets printed, centred in it. Measuring the printed
%    copy instead makes the band's height follow the letters of the title: the
%    demo's own "Customisation Examples (cont.)" grew the band by 2.4pt over
%    its neighbours, because parentheses descend. Struts make the height depend
%    on the number of lines and nothing else, while centring the real ink keeps
%    an all-capitals line optically centred instead of sitting low by its
%    (absent) descender. The content is therefore built twice — so a
%    \footnote or anything else with a side effect does not belong in a frame
%    title.
% 2. `\ifx\insertframesubtitle\@empty` is not to be trusted for "is this field
%    empty" (see the title page, where the same test on \insertsubtitle is
%    never true). \mcm@ftifny answers it by measurement: the field goes into a
%    \parbox whose height is compared with that of an empty one — an empty
%    \parbox is 2.74pt tall, not 0pt, so the comparison must be against an
%    empty box and never against \z@.
% 3. The subtitle is not uppercased and not tracked, and the band is ragged
%    right: a wrapping title justified to the margin comes out with gaping
%    word spaces, and the tracked capitals of \mcmTitleMetaFormat are for the
%    title page's meta lines — a sentence set that way is unreadable.
% ---------------------------------------------------------------------------
\newlength{\mcmFrameTitleLeft}
\setlength{\mcmFrameTitleLeft}{0.35cm}

\newlength{\mcmFrameTitleRight}
\setlength{\mcmFrameTitleRight}{0.40cm}

\newlength{\mcmFrameTitleHeight}
\setlength{\mcmFrameTitleHeight}{1.10cm}

\newlength{\mcmFrameSubtitleSep}
\setlength{\mcmFrameSubtitleSep}{0.03cm}

\newlength{\mcmFrameSubtitleGrow}
\setlength{\mcmFrameSubtitleGrow}{0.30cm}

\newlength{\mcmFrameTitleRise}
\setlength{\mcmFrameTitleRise}{0pt}

\newlength{\mcmFrameSubtitleSink}
\setlength{\mcmFrameSubtitleSink}{1pt}

\newcommand{\mcmFrameTitleWidth}{%
  \dimexpr\paperwidth-\mcmFrameTitleLeft-\mcmFrameTitleRight\relax}

\newsavebox{\mcm@ftbox}      % the content as printed
\newsavebox{\mcm@ftref}      % the same, strutted, for the height
\newsavebox{\mcm@ftline}     % one strutted line of title, for the white
\newsavebox{\mcm@ftsline}    % one strutted line of subtitle
\newsavebox{\mcm@ftprobe}
\newsavebox{\mcm@ftvoid}
\newlength{\mcm@fth}
\newlength{\mcm@ftnom}   % content height by line count
\newlength{\mcm@fttop}   % white above the capitals
\newlength{\mcm@ftbls}     % \baselineskip of the title font
\newlength{\mcm@ftsbls}    % \baselineskip of the subtitle font
\newcount\mcm@ftnt         % lines in the title
\newcount\mcm@ftns         % lines in the subtitle
\newif\if@mcmftsub

\newcommand{\mcm@ftstrut}{\vphantom{Xp}}

% "#1 is not empty" — measured, not tested with \ifx. (The title page has its
% own copy of this, \mcm@tifny, tied to \mcmTitleBlockWidth.)
\newcommand{\mcm@ftifny}[2]{%
  \sbox\mcm@ftprobe{\parbox{\mcmFrameTitleWidth}{#1}}%
  \sbox\mcm@ftvoid{\parbox{\mcmFrameTitleWidth}{}}%
  \ifdim\dimexpr\ht\mcm@ftprobe+\dp\mcm@ftprobe\relax
       >\dimexpr\ht\mcm@ftvoid+\dp\mcm@ftvoid\relax #2\fi}

% The band's content. #1 is \mcm@ftstrut for the copy that is measured and
% \relax for the copy that is printed.
% The content, as a \vtop: its \ht is the FIRST line's height and its \dp
% everything below that first baseline. That is what the placement below needs
% — a minipage would not do, [c] putting the reference point in the middle and
% [t] putting it at the very top of the box, neither of which is a baseline.
% #1 is \mcm@ftstrut for the copy that is measured and \relax for the copy
% that is printed.
\newcommand{\mcm@ftbuild}[1]{%
  \vtop{\hsize\mcmFrameTitleWidth
    \parindent\z@\raggedright\hyphenpenalty=5000\relax
    % \noindent FIRST: \usebeamercolor drops a colour whatsit, and a whatsit
    % contributed in vertical mode becomes the \vtop's first item — its \ht
    % would then be 0 and the whole content would hang below the baseline,
    % which is not what the placement below expects.
    {\usebeamerfont{frametitle}\noindent\usebeamercolor[fg]{frametitle}%
     #1\mcmTitleFormat{\insertframetitle}\if@mcmftsub\else#1\fi\par}%
    \if@mcmftsub
      \vskip\mcmFrameSubtitleSep
      {\usebeamerfont{framesubtitle}\noindent\usebeamercolor[fg]{framesubtitle}%
       \mcmFrameSubtitleFormat{\insertframesubtitle}#1\par}%
    \fi}}

% How many lines each field takes, and at what baselineskip. \prevgraf is the
% line count of the paragraph just ended; it has to be read inside the box and
% carried out with \global.
\newcommand{\mcm@ftcount}{%
  \global\mcm@ftnt=1 \global\mcm@ftns=0
  \setbox\mcm@ftref\vbox{\hsize\mcmFrameTitleWidth
    \raggedright\hyphenpenalty=5000\relax
    {\usebeamerfont{frametitle}\global\mcm@ftbls=\baselineskip
     \mcmTitleFormat{\insertframetitle}\par\global\mcm@ftnt=\prevgraf}%
    \if@mcmftsub
      {\usebeamerfont{framesubtitle}\global\mcm@ftsbls=\baselineskip
       \mcmFrameSubtitleFormat{\insertframesubtitle}\par
       \global\mcm@ftns=\prevgraf}%
    \fi}%
  \ifnum\mcm@ftnt<1 \global\mcm@ftnt=1 \fi}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \@mcmftsubfalse
  \mcm@ftifny{\insertframesubtitle}{\@mcmftsubtrue}%
  % The band's height is a *line count*, never a measurement of the ink: one
  % line is \mcmFrameTitleHeight, every further title line adds one title
  % baselineskip, and a subtitle adds the separation plus its own lines. That
  % is what keeps the band — and the body under it — from shifting by a point
  % or two between slides because one title has an accented capital and the
  % next has none. Measuring the box instead moved the demo's own
  % "Customisation Examples (cont.)" down by 2.4pt: parentheses descend.
  \mcm@ftcount
  % the reference: one strutted line of title, as a \vtop, so \ht is the
  % line's height above its baseline and \dp the descender the strut reserves
  \sbox\mcm@ftline{\vtop{\hsize\mcmFrameTitleWidth\parindent\z@
      \usebeamerfont{frametitle}\mcm@ftstrut\par}}%
  \sbox\mcm@ftsline{\vtop{\hsize\mcmFrameTitleWidth\parindent\z@
      \usebeamerfont{framesubtitle}\mcm@ftstrut\par}}%
  \setlength{\mcm@fth}{\mcmFrameTitleHeight}%
  \advance\mcm@fth\mcm@ftnt\mcm@ftbls
  \advance\mcm@fth-\mcm@ftbls
  % The first subtitle line rides in the white a one-line band already carries
  % (some 22pt of it), so it costs \mcmFrameSubtitleGrow rather than a whole
  % line: 0.30cm instead of the 14.7pt a second line would otherwise add.
  % Every further subtitle line, like every further title line, does add its
  % own baselineskip — past two lines the white really has been spent.
  \if@mcmftsub
    \advance\mcm@fth\mcmFrameSubtitleGrow
    \ifnum\mcm@ftns>1
      \advance\mcm@fth\mcm@ftns\mcm@ftsbls
      \advance\mcm@fth-\mcm@ftsbls
    \fi
  \fi
  % The content's *nominal* height, by the same line count — what the band
  % would hold if every line were exactly one strutted line.
  % Careful: the depth to count is the LAST line's, not the title's. Adding the
  % title's descender when a subtitle follows counts a depth that sits in the
  % middle of the block, and the pair comes out a point too high.
  \setlength{\mcm@ftnom}{\ht\mcm@ftline}%
  \advance\mcm@ftnom\mcm@ftnt\mcm@ftbls
  \advance\mcm@ftnom-\mcm@ftbls
  \if@mcmftsub
    \advance\mcm@ftnom\mcmFrameSubtitleSep
    \advance\mcm@ftnom\mcm@ftns\mcm@ftsbls
    \advance\mcm@ftnom\dp\mcm@ftsline
  \else
    \advance\mcm@ftnom\dp\mcm@ftline
  \fi
  \sbox\mcm@ftbox{\mcm@ftbuild{\relax}}%
  % Overflow guard: should the ink ever be taller than the band the line count
  % asked for (a huge font override), give it room rather than let it run out.
  % The margin is deliberately small — it must not undo the line above.
  \ifdim\dimexpr\ht\mcm@ftbox+\dp\mcm@ftbox+0.12cm\relax>\mcm@fth
    \setlength{\mcm@fth}{\dimexpr\ht\mcm@ftbox+\dp\mcm@ftbox+0.12cm\relax}%
  \fi
  % --- where the text sits in the band -------------------------------------
  % The white above is measured to the CAPITALS and computed from the line
  % count, never from the ink: the box is placed by a fixed \vskip and its
  % height is forced to that of one strutted line, so the first baseline lands
  % at the same place on every slide. Centring the ink instead — which is what
  % \vfil...\vfil around the real box does — lifts a title whose glyphs have
  % depth: "Customisation Examples (cont.)" sat 1.5pt higher than its
  % neighbours because parentheses descend, and that is the "too high on some
  % slides" this replaces. Accents now hang into the white above and
  % descenders into the white below, as they do in the blocks.
  %
  % Then one correction: what the eye centres is the ink block, from the
  % capitals of the first line down to the LAST BASELINE, not the strutted box
  % whose bottom sits a descender lower. So half the last line's reference
  % descender is given back to the white above — the title's own when it is
  % alone, the subtitle's when there is one. Without it the pair of lines
  % reads as sitting high in the band.
  \setlength{\mcm@fttop}{0.5\dimexpr\mcm@fth-\mcm@ftnom\relax}%
  \if@mcmftsub
    \advance\mcm@fttop0.5\dp\mcm@ftsline
    \advance\mcm@fttop\mcmFrameSubtitleSink
  \else
    \advance\mcm@fttop0.5\dp\mcm@ftline
  \fi
  \advance\mcm@fttop-\mcmFrameTitleRise
  \ifdim\mcm@fttop<\z@\setlength{\mcm@fttop}{\z@}\fi
  \ht\mcm@ftbox=\ht\mcm@ftline
  \begin{beamercolorbox}[%
      wd=\paperwidth,
      ht=\mcm@fth, dp=0.0cm,
      leftskip=\mcmFrameTitleLeft, rightskip=\mcmFrameTitleRight]{frametitle}%
    \vbox to \mcm@fth{%
      \vskip\mcm@fttop
      \noindent\usebox\mcm@ftbox\par
      \vss
    }%
  \end{beamercolorbox}%
  % The accent line is drawn *in the flow*, in a box of zero height so it
  % takes no space, and never as a `remember picture, overlay` tikzpicture:
  % pgf resolves `current page` anchors at shipout, and a yshift written as
  % \mcm@fth is re-expanded there too — with whatever value that length holds
  % by then. The line then lands inside the band on a slide whose band is
  % taller than the last one's. A literal 1.10cm never showed the bug because
  % it could not change.
  % Bleeding to the page edges is done the way beamercolorbox does it: an
  % \hbox to\textwidth whose two glues may shrink by the frame margins. A bare
  % \rule{\paperwidth} starts at the text block's left edge instead and leaves
  % the first 0.76cm of the line unpainted.
  \nointerlineskip
  \vbox to 0pt{%
    \hbox to\textwidth{%
      \hskip0pt minus\beamer@leftmargin\relax
      \color{mcmPrimaryFg}\rule{\paperwidth}{0.8pt}%
      \hskip0pt minus\beamer@rightmargin\relax}%
    \vss}%
  \nointerlineskip
}

% ---------------------------------------------------------------------------
% BLOCKS
%
% A plain block is a pip, a title and its text on the page background. An
% alert or example block is a *title band* in a strong value of its own pastel
% over a body in the pale one (roadmap point 7: base "B" + treatment "J3",
% settled 2026-09-01 after seven rounds of mock-ups in local_testing/blocks/).
%
% Knobs
%   \mcmBlockPad          0.45em  horizontal padding inside a block
%   \mcmBlockPadTop       0.55em  white above the title's ink        (6.0pt/11pt)
%   \mcmBlockPadBot       0.55em  white below the last baseline      (6.0pt/11pt)
%   \mcmBandPad           0.47em  white above the capital and below the
%                                 baseline of a title band           (5.2pt/11pt)
%   \mcmBlockTitleIndent  0.3em   title indent; the pip hangs left of it
%   \mcmBlockSep          1em     visible gap a block leaves around itself
%
% \mcmBlockSep is the *visible* gap a block leaves around itself, and stacking
% blocks needs no manual \vspace: half of it is placed above and half below.
%
% Getting that gap to look the same for every block type takes one correction.
% Each block is a beamercolorbox whose background is inset by \mcmBlockPad
% (colsep*) plus 0.5ex (sep) on every side. On alert/example blocks that inset
% is visible — it is the coloured margin around the text. On a plain block the
% background is mcmBg, the same colour as the page, so the identical inset is
% invisible whitespace, and two stacked plain blocks read as though they were
% pushed 2*\mcmBlockInset further apart than two coloured ones.
%
% So a plain block subtracts that invisible inset back out of the skips around
% it, and coloured blocks do not. The visible gap then comes out at
% \mcmBlockSep for every combination — plain/plain, plain/coloured,
% coloured/coloured.
%
% The correction applies to the *skips*, never to the box: the inset itself is
% identical for all three types, so blocks of different types side by side in a
% columns[T] row still line their titles up. That is also why the skip *above*
% a plain block is conditional. Subtracting it unconditionally would raise a
% plain block above a coloured one in the neighbouring column, and demo.tex
% puts block/alertblock/exampleblock in exactly that arrangement. It is only
% correct to subtract when something sits above for the gap to be measured
% against — i.e. when this block directly follows another block, which is
% precisely when \lastskip is still one of the two skips below. A columns[T]
% column instead opens with beamer's own \vskip-1ex, and body text leaves a
% box rather than glue (\lastskip = 0pt), so neither is mistaken for a block.
%
% The \nointerlineskip below each block is what makes the gap come out at
% \mcmBlockSep exactly rather than approximately. Left to itself TeX adds
% interline glue of \baselineskip minus the previous depth minus the height of
% whatever box comes next, so the gap would quietly depend on what follows: a
% following block is tall and gets the \lineskip minimum, but a columns[T] row
% is an \hbox of \vtops whose height is only its first line, which used to add
% some 15bp on top of the intended gap. Suppressing it makes a block leave the
% same space above a columns row as above another block.
%
% (The subtraction assumes the plain "block body" colour keeps a bg — beamer
% only applies colsep* when one is set. Blanking it would over-subtract.)
%
% ---- VERTICAL WHITE: five traps, every one of them measured on rendered
% ---- pages at 600dpi, not read off the source ------------------------------
%
% 1. `vmode` is NOT optional on these beamercolorboxes. Without it beamer runs
%    \leavevmode just before the content, a \vskip there splits the paragraph
%    in two, and TeX slides ~3.1pt of interline glue in above the title: the
%    padding then bites only from the bottom. That was the whole of the third
%    round of mock-ups, discarded for this bug.
%
% 2. colsep* and sep put the same space at the top and the bottom as at the
%    sides. 0.45em + 0.5ex = 7.82pt is right horizontally and too much
%    vertically, so every box opens and closes with a negative \vskip that
%    trims it back to the wanted value. Change \mcmBlockPad or the sep= and
%    those trims follow automatically — they are written as differences.
%
% 3. A line's height and depth follow the glyphs that are actually in it. A
%    title with no descender ("Limite") made a band 2.2pt shorter than one with
%    ("Exemple"), and an accented capital made it 0.9pt taller. Every title and
%    every body's last line therefore carries \mcmBlockStrut (\vphantom{Xp}),
%    the reference capital-plus-descender, and what an accent sticks out above
%    that reference is measured and taken off the white above. The band is then
%    pad + capital + pad whatever the letters, and descenders hang into the
%    bottom white the way accents hang into the top one.
%
% 4. The strut has to be at BOTH ends of the title, and the overshoot has to be
%    measured on the real first line — hence the \vtop at \linewidth in
%    \mcm@blockrefs, whose \ht is by definition the first line. Measuring the
%    title in an \hbox instead (as the first version did) charges the top white
%    for an accent that ends up on the second line, and leaves the last line
%    with no depth at all: a two-line title then swung 4.3pt in height.
%
% 5. The title indent is \advance\leftskip, never \leftskip=: the
%    beamercolorbox builds its own left inset out of that same register
%    (beamerbasecolor.sty), so assigning to it drags the whole title 7.8pt to
%    the left. The pip stays in an \llap, so it marks the first line only.
%
% The title is typeset twice — once measured, once printed — so a \footnote or
% anything else with a side effect does not belong in a block title.
% ---------------------------------------------------------------------------
\newlength{\mcmBlockPad}
\setlength{\mcmBlockPad}{0.45em}

\newlength{\mcmBlockPadTop}
\setlength{\mcmBlockPadTop}{0.55em}

\newlength{\mcmBlockPadBot}
\setlength{\mcmBlockPadBot}{0.55em}

\newlength{\mcmBandPad}
\setlength{\mcmBandPad}{0.47em}

\newlength{\mcmBlockTitleIndent}
\setlength{\mcmBlockTitleIndent}{0.3em}

\newlength{\mcmBlockSep}
\setlength{\mcmBlockSep}{1em}

% The invisible inset of a plain block, on which the gap correction rests: the
% white above the title's ink and below the last baseline, i.e. the mean of the
% two vertical pads.
\newcommand{\mcmBlockInset}{\dimexpr0.5\mcmBlockPadTop+0.5\mcmBlockPadBot\relax}

% Half of \mcmBlockSep, less the invisible inset of a plain block.
\newcommand{\mcmBlockHalfSep}{\dimexpr0.5\mcmBlockSep-\mcmBlockInset\relax}

\newcommand{\mcmBlockAbove}{%
  \ifdim\lastskip=\mcmBlockHalfSep\relax      % follows a plain block
    \vskip\mcmBlockHalfSep
  \else\ifdim\lastskip=0.5\mcmBlockSep\relax  % follows a coloured block
    \vskip\mcmBlockHalfSep
  \else                                       % starts a column, or follows text
    \vskip0.5\mcmBlockSep%
  \fi\fi}
\newcommand{\mcmBlockBelow}{\vskip\mcmBlockHalfSep\nointerlineskip}

% Coloured blocks need no correction: their inset is visible, so it reads as
% part of the block rather than as part of the gap.
\newcommand{\mcmBlockAboveColoured}{\vskip0.5\mcmBlockSep}
\newcommand{\mcmBlockBelowColoured}{\vskip0.5\mcmBlockSep\nointerlineskip}

% --- line metrics ----------------------------------------------------------
\newlength{\mcm@bover}                 % accent above the reference capital
\newlength{\mcm@bdesc}                 % reference descender
\newlength{\mcm@pover}                 % pip above the first line of the title
\newsavebox{\mcm@titlebox}
\newsavebox{\mcm@refbox}
\newsavebox{\mcm@pipbox}

\newcommand{\mcmBlockStrut}{\vphantom{Xp}}

% The title as it will really be broken, plus the reference line. Call inside
% the colorbox, where \linewidth is the block's width.
\newcommand{\mcm@blockrefs}{%
  \sbox\mcm@refbox{\usebeamerfont{block title}Xp}%
  \setbox\mcm@titlebox\vtop{\hsize\linewidth
    \usebeamerfont{block title}%
    \noindent\mcmBlockStrut\insertblocktitle\mcmBlockStrut\par}%
  \setlength{\mcm@bdesc}{\dp\mcm@refbox}%
  \setlength{\mcm@bover}{\dimexpr\ht\mcm@titlebox-\ht\mcm@refbox\relax}%
  \ifdim\mcm@bover<\z@\setlength{\mcm@bover}{\z@}\fi
  \sbox\mcm@pipbox{\rule{3pt}{1.75ex}}%
  \setlength{\mcm@pover}{\dimexpr\ht\mcm@pipbox-\ht\mcm@titlebox\relax}%
  \ifdim\mcm@pover<\z@\setlength{\mcm@pover}{\z@}\fi}

% top of a block whose first line carries the pip (the pip is taller than the
% capitals, so what it sticks out comes off the white)
\newcommand{\mcm@toptrim}[1]{\vskip\dimexpr#1-\mcmBlockPad-0.5ex-\mcm@pover\relax}
% top of a block body under a band: no pip, nothing to deduct
\newcommand{\mcm@toptrimflat}[1]{\vskip\dimexpr#1-\mcmBlockPad-0.5ex\relax}
% bottom of a block body: the white is counted under the last BASELINE, so a
% descender hangs into it instead of making the block 2.3pt taller. Only when
% the body ends in horizontal mode — after a list there is no line of ours to
% strut, and the reference descender must then not be subtracted either.
\newcommand{\mcm@bottrim}[1]{%
  \ifhmode
    \sbox\mcm@refbox{\mcmBlockStrut}%
    \mcmBlockStrut\par
    \vskip\dimexpr#1-\dp\mcm@refbox-\mcmBlockPad-0.5ex\relax
  \else
    \vskip\dimexpr#1-\mcmBlockPad-0.5ex\relax
  \fi}

% --- plain block: pip + title, no visible background -----------------------
\setbeamertemplate{block begin}{%
  \par\mcmBlockAbove%
  \begin{beamercolorbox}[%
      wd=\textwidth, colsep*=\mcmBlockPad,
      sep=0.5ex, vmode]{block body}%
    \mcm@blockrefs\mcm@toptrim{\mcmBlockPadTop}%
    {\advance\leftskip\mcmBlockTitleIndent
     \noindent\llap{\textcolor{mcmPip}{\rule{3pt}{1.75ex}}\hspace{0.45em}}%
     \usebeamerfont{block title}\usebeamercolor[fg]{block title}%
     \mcmBlockStrut\insertblocktitle\mcmBlockStrut\par}%
    \vskip0.4ex
    \usebeamerfont{block body}\usebeamercolor[fg]{block body}%
}
\setbeamertemplate{block end}{%
  \mcm@bottrim{\mcmBlockPadBot}\end{beamercolorbox}\mcmBlockBelow%
}

% --- coloured blocks: title band over a pale body ---------------------------
% Two stacked colorboxes. The \vskip-0.5pt closes the hairline the renderer
% would otherwise show between them; the {\parskip0pt\par}\nointerlineskip
% keeps the paragraph break between the two boxes from adding anything.
\newcommand{\mcm@bandbegin}[3]{% #1 band colour, #2 body colour, #3 bullet colour
  \par\mcmBlockAboveColoured%
  \begin{beamercolorbox}[%
      wd=\textwidth, colsep*=\mcmBlockPad,
      sep=0.5ex, vmode]{#1}%
    \mcm@blockrefs
    \vskip\dimexpr\mcmBandPad-\mcmBlockPad-0.5ex-\mcm@bover\relax
    {\usebeamerfont{block title}\mcmBlockStrut\insertblocktitle\mcmBlockStrut\par}%
    \par\vskip\dimexpr\mcmBandPad-\mcm@bdesc-\mcmBlockPad-0.5ex\relax
  \end{beamercolorbox}%
  {\parskip0pt\par}\nointerlineskip\vskip-0.5pt%
  \begin{beamercolorbox}[%
      wd=\textwidth, colsep*=\mcmBlockPad,
      sep=0.5ex, vmode]{#2}%
    \mcm@toptrimflat{\mcmBlockPadTop}%
    \usebeamerfont{block body}\usebeamercolor[fg]{#2}%
    \renewcommand{\mcmBulletColor}{#3}%
}
\newcommand{\mcm@bandend}{%
  \mcm@bottrim{\mcmBlockPadBot}\end{beamercolorbox}\mcmBlockBelowColoured%
}

\setbeamertemplate{block alerted begin}{%
  \mcm@bandbegin{block title alerted}{block body alerted}{mcmAlert}%
}
\setbeamertemplate{block alerted end}{\mcm@bandend}

\setbeamertemplate{block example begin}{%
  \mcm@bandbegin{block title example}{block body example}{mcmExample}%
}
\setbeamertemplate{block example end}{\mcm@bandend}

% ---------------------------------------------------------------------------
% ITEMIZE / ENUMERATE — geometric bullets, colour follows theme
% ---------------------------------------------------------------------------
\addtobeamertemplate{block alerted begin}{\renewcommand{\mcmBulletColor}{mcmAlert}}{}
\addtobeamertemplate{block alerted end}{\renewcommand{\mcmBulletColor}{mcmPip}}{}
\addtobeamertemplate{block example begin}{\renewcommand{\mcmBulletColor}{mcmExample}}{}
\addtobeamertemplate{block example end}{\renewcommand{\mcmBulletColor}{mcmPip}}{}

% The mark is the running font's own en dash, at every level: it inherits the
% font, the series and — crucially — the size of the level it sits on, so the
% three levels need no separate calibration and stay right if the body size
% ever changes. Hierarchy is carried by the indentation, as in Swiss practice.
\setbeamertemplate{itemize item}{\textcolor{\mcmBulletColor}{\textendash}}
\setbeamertemplate{itemize subitem}{\textcolor{\mcmBulletColor}{\textendash}}
\setbeamertemplate{itemize subsubitem}{\textcolor{\mcmBulletColor}{\textendash}}

% Numerals, bare: bold at level 1, light below. Each numeral is one step
% smaller than the body text of its own level.
%
% Trap: \usebeamerfont*{itemize subitem} does NOT shrink a label — it resets it
% to \normalsize, so a nested numeral comes out at level-1 size beside \small
% text. The size must come from the *body* font names below, plus the explicit
% one-step reduction.
\setbeamertemplate{enumerate item}{%
  {\usebeamerfont*{itemize/enumerate body}\small
   \color{\mcmBulletColor}\bfseries\insertenumlabel}%
}
\setbeamertemplate{enumerate subitem}{%
  {\usebeamerfont*{itemize/enumerate subbody}\footnotesize
   \color{\mcmBulletColor}\insertsubenumlabel}%
}
\setbeamertemplate{enumerate subsubitem}{%
  {\usebeamerfont*{itemize/enumerate subsubbody}\scriptsize
   \color{\mcmBulletColor}\insertsubsubenumlabel}%
}
% ---------------------------------------------------------------------------
% TABLE OF CONTENTS
% ---------------------------------------------------------------------------
\setbeamertemplate{section in toc}{%
  \hspace{0.1cm}%
  \raisebox{0.2ex}{\tikz{\fill[mcmPip](0,0) rectangle (0.14,0.14);}}%
  \hspace{0.25cm}%
  {\usebeamerfont{section in toc}\inserttocsection}\par%
}
\setbeamertemplate{subsection in toc}{%
  \hspace{0.65cm}%
  \raisebox{0.0ex}{\tikz{\fill[mcmPip] (0,0) circle(0.055);}}%
  \hspace{0.2cm}%
  {\usebeamerfont{subsection in toc}\inserttocsubsection}\par%
}

% ---------------------------------------------------------------------------
% FOOTLINE — progress bar, suppressed on the title page
% ---------------------------------------------------------------------------
\newif\if@mcmtitlepage
\@mcmtitlepagefalse

\addtobeamertemplate{frametitle}{\global\@mcmtitlepagefalse}{}
\BeforeBeginEnvironment{frame}{\global\@mcmtitlepagefalse}

\newcommand{\mcmFootlineContent}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[mcmPrimaryMuted]
      (current page.south west)
      rectangle ([yshift=0.06cm]current page.south east);
    % min(...) guards against \inserttotalframenumber defaulting to 1 on a
    % fresh compile (no .aux yet): without it, \mcmprog would equal the raw
    % frame number past the first pass of any 40+ frame deck, and
    % \mcmprog\paperwidth below would overflow TeX's max dimension.
    \pgfmathsetmacro{\mcmprog}{min(1, \insertframenumber / \inserttotalframenumber)}%
    \fill[mcmPrimary]
      (current page.south west)
      rectangle ([xshift=\mcmprog\paperwidth, yshift=0.06cm]current page.south west);
    \node[anchor=south west, inner sep=0pt]
      at ([xshift=0.4cm, yshift=0.10cm]current page.south west)
      {{\tiny\color{mcmBlack!45}\insertshortauthor}};
    \node[anchor=south, inner sep=0pt]
      at ([yshift=0.10cm]current page.south)
      {{\tiny\color{mcmBlack!45}\insertshorttitle}};
    \node[anchor=south east, inner sep=0pt]
      at ([xshift=-0.4cm, yshift=0.10cm]current page.south east)
      {{\tiny\color{mcmBlack!45}\textbf{\insertframenumber}\,/\,\inserttotalframenumber}};
  \end{tikzpicture}%
  \leavevmode\hbox to \paperwidth{\vbox to 0.45cm{}\hss}%
}

\setbeamertemplate{footline}{%
  \if@mcmtitlepage\else\mcmFootlineContent\fi%
}

% ---------------------------------------------------------------------------
% SECTION PAGE
% ---------------------------------------------------------------------------
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[mcmBg]
      (current page.south west) rectangle (current page.north east);
    \fill[mcmPrimary]
      (current page.south west)
      rectangle ([xshift=0.45cm]current page.north west);
    \fill[mcmPrimary!45]
      ([xshift=0.45cm]current page.south west)
      rectangle ([xshift=0.60cm]current page.north west);
    \node[anchor=south west, inner sep=0pt,
          font=\small\bfseries, text=mcmPrimary!55]
      at ([xshift=1.1cm, yshift=0.18cm]current page.west)
      {\MakeUppercase{Section}\ \insertsectionnumber};
    \node[anchor=west, text width=0.80\paperwidth,
          align=left, inner sep=0pt]
      at ([xshift=1.1cm, yshift=-0.55cm]current page.west)
      % \mcmTitleFont, so a section title is set in the title face like every
      % other title in the theme. \usebeamerfont{title} alone would leave it in
      % the *body* font, which is where it used to sit.
      {{\mcmTitleFont\usebeamerfont{title}\color{mcmPrimary}\insertsection}};
  \end{tikzpicture}%
}

% ---------------------------------------------------------------------------
% SUBSECTION PAGE
% ---------------------------------------------------------------------------
\setbeamertemplate{subsection page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[mcmBg]
      (current page.south west) rectangle (current page.north east);
    \fill[mcmPrimary]
      (current page.north west)
      rectangle ([yshift=-0.18cm]current page.north east);
    \node[anchor=north west, inner sep=0pt,
          font=\small, text=mcmPrimary!50]
      at ([xshift=1.1cm, yshift=-0.38cm]current page.north west)
      {\insertsection\ \textbf{/}};
    \node[anchor=west, text width=0.80\paperwidth,
          align=left, inner sep=0pt]
      at ([xshift=1.1cm, yshift=0.4cm]current page.west)
      {%
        {\small\color{mcmPrimary!60}\MakeUppercase{Section}\ %
         \insertsectionnumber.\insertsubsectionnumber}\\[0.3cm]
        % \mcmTitleFont for the same reason as on the section page above.
        {\mcmTitleFont\usebeamerfont{frametitle}\color{mcmPrimary}%
         \insertsubsection}%
      };
  \end{tikzpicture}%
}


% ---------------------------------------------------------------------------
% TITLE PAGE
%
% Layout knobs
%   \mcmFooterHeight       footer strip height              (default 4.15em)
%   \mcmLogoVOffset        logo vertical offset             (default 0cm)
%   \mcmLineSpacing        scan line spacing                (default 0.15cm)
%   \mcmTitleStripRef      strip height the text block sits on (default 5em)
%   \mcmTitleBlockWidth    width of the text block          (default 0.88\paperwidth)
%   \mcmTitleRightMargin   its distance to the right edge   (default 0.06\paperwidth)
%   \mcmTitleTopMargin     clearance below the top edge     (default 1.30cm)
%   \mcmTitleFooterGap     clearance above the footer strip (default 0.5cm)
%
% Type sizes and vertical rhythm (all scaled together by the auto-fit below)
%   \mcmTitleFS \mcmSubtitleFS \mcmAuthorFS \mcmInstituteFS \mcmDateFS
%   \mcmTitleSubtitleSep \mcmTitleRuleSep \mcmTitleAuthorSep
%   \mcmTitleInstituteSep \mcmTitleDateSep
%   \mcmTitleRuleWidth \mcmTitleRuleThickness
%
% Subtitle, author, institute and date are set in letterspaced capitals
% (\mcmTitleMetaFormat); \mcmTitleMetaCapsfalse gives them back as written,
% which is what a nine-name author list wants.
%
% AUTO-FIT.  Title, subtitle, author and institute are typeset into a single
% box which is then measured.  Too tall for the space between the top margin
% and the date line?  Every type size and every gap is scaled down in 4%
% steps until it fits (floor \mcmTitleMinScale).  Much shorter than that
% space?  They are scaled *up* the same way (ceiling \mcmTitleMaxScale) so a
% two-word title does not look lost on an empty slide.  The block is then
% centred in whatever room is left.  That is what lets one template carry a
% two-word title and a thirty-word one.
%
% Empty fields cost nothing: each element is measured before it is emitted,
% so an absent subtitle/author/institute/date leaves no gap behind.  (Do not
% go back to `\ifx\insertsubtitle\@empty' — beamer never makes that test
% true, so the subtitle gap was always inserted, even with no subtitle.)
%
% The logo is automatically positioned so that there is always 0.75cm of
% scan lines to its right. The gap width adapts to the logo size.
% Both gap edges use cosine-modulated rounding for an organic shape.
% ---------------------------------------------------------------------------
\newsavebox{\mcmTitleGraphicBox}
\newlength{\mcmLogoW}
\newlength{\mcmLogoH}
% Strip height. 4.15em is 1.6cm at the default 11pt; the floor is the logo,
% 0.8cm tall for the demo's 3cm-wide mark, which leaves it 0.4cm of air.
\newlength{\mcmFooterHeight}
\setlength{\mcmFooterHeight}{4.15em}
\newlength{\mcmLogoVOffset}
\setlength{\mcmLogoVOffset}{0cm}
\newif\if@mcmhaslogo

% Scan line spacing, kept at ~9.3% of the strip height so the seven lines hold
% the same proportion of it they had when the strip was taller.
\newlength{\mcmLineSpacing}
\setlength{\mcmLineSpacing}{0.15cm}

% --- Text block geometry ---------------------------------------------------
\newlength{\mcmTitleBlockWidth}
\newlength{\mcmTitleRightMargin}
\newlength{\mcmTitleTopMargin}
\setlength{\mcmTitleTopMargin}{1.30cm}
\newlength{\mcmTitleFooterGap}
\setlength{\mcmTitleFooterGap}{0.5cm}
% (set here, not \AtBeginDocument, so a preamble override wins)
\setlength{\mcmTitleBlockWidth}{0.88\paperwidth}
\setlength{\mcmTitleRightMargin}{0.06\paperwidth}

% Never let the mass rise closer than this to the top edge (it only bites when
% the block is still too tall at \mcmTitleMinScale).
\newlength{\mcmTitleTopMin}
\setlength{\mcmTitleTopMin}{0.45cm}

% --- Where the title block's floor sits ------------------------------------
% The floor follows max(\mcmFooterHeight, \mcmTitleStripRef), not the strip
% itself: a shorter strip then frees coloured background under the date instead
% of pulling the whole block down (and letting the auto-fit grow it). 5em is the
% height the strip had when the block's position was settled, so shortening the
% strip to 4.15em left everything above it exactly where it was. A *taller*
% strip still pushes the block up. \setlength{\mcmTitleStripRef}{0pt} makes the
% block follow the strip again.
\newlength{\mcmTitleStripRef}
\setlength{\mcmTitleStripRef}{5em}
\newlength{\mcmTitleFloorH}

% --- Type sizes and vertical rhythm on the title page ----------------------
% The secondary fields are small: their rank comes mostly from the letterspaced
% capitals, not from size. The one exception is the author, at 11pt: the name
% is what the reader looks for, so it must clearly outrank the institute below
% it -- 9.5pt over 8pt was a difference one had to go looking for. 11pt is the
% ceiling, not a taste: at 12pt the nine-author case of test/titlepage.tex
% breaks between a first name and its surname (GRETA / KELLWIG), and nothing
% catches that -- the auto-fit measures height, never the width of a line.
\newlength{\mcmTitleFS}     \setlength{\mcmTitleFS}{21pt}
\newlength{\mcmSubtitleFS}  \setlength{\mcmSubtitleFS}{8.5pt}
\newlength{\mcmAuthorFS}    \setlength{\mcmAuthorFS}{11pt}
\newlength{\mcmInstituteFS} \setlength{\mcmInstituteFS}{8pt}
\newlength{\mcmDateFS}      \setlength{\mcmDateFS}{6.5pt}

% The rule sits under the title *and its subtitle*: the subtitle names the
% talk, not the people giving it, so it belongs with the title. Hence the
% tight title/subtitle gap and the equal gaps on either side of the rule.
\newlength{\mcmTitleSubtitleSep}  \setlength{\mcmTitleSubtitleSep}{0.22cm}
\newlength{\mcmTitleRuleSep}      \setlength{\mcmTitleRuleSep}{0.42cm}
\newlength{\mcmTitleAuthorSep}    \setlength{\mcmTitleAuthorSep}{0.42cm}
\newlength{\mcmTitleInstituteSep} \setlength{\mcmTitleInstituteSep}{0.18cm}
\newlength{\mcmTitleDateSep}      \setlength{\mcmTitleDateSep}{0.45cm}

\newlength{\mcmTitleRuleWidth}     \setlength{\mcmTitleRuleWidth}{2.2cm}
\newlength{\mcmTitleRuleThickness} \setlength{\mcmTitleRuleThickness}{0.7pt}

% --- Auto-fit bounds, in percent of the nominal size -----------------------
\newcommand{\mcmTitleMinScale}{55}   % never shrink below 55%
\newcommand{\mcmTitleMaxScale}{145}  % never grow above 145%
\newcommand{\mcmTitleFillScale}{62}  % grow while shorter than 62% of the room

% --- Machinery -------------------------------------------------------------
\newsavebox{\mcmTitleBlockBox}
\newsavebox{\mcmTitleDateBox}
\newsavebox{\mcmTitleProbeBox}
\newsavebox{\mcmTitleEmptyBox}
\newif\if@mcmhasdate       % set while the date box is built
\newlength{\mcmTitleAvail}   % vertical room the block must fit in
\newlength{\mcmTitleMass}    % block + its gap to the date + the date
\newlength{\mcmTitleAir}     % empty space above the mass (= below it)
\newlength{\mcmTitleBase}    % y of the bottom of that room, from page south
\newlength{\mcmTitleTop}     % y of the top of the block, from page south
\newlength{\mcmTitleFSa}
\newlength{\mcmTitleFSb}
\newcount\mcm@tpc            % current scale, in percent
\newif\if@mcmTitleFit

% Scale a length by the current auto-fit percentage.
\newcommand{\mcm@tsc}[1]{\dimexpr#1*\mcm@tpc/100\relax}

% Select a font at a scaled size; #1 = nominal size, #2 = leading factor.
\newcommand{\mcm@tfs}[2]{%
  \setlength{\mcmTitleFSa}{\mcm@tsc{#1}}%
  \setlength{\mcmTitleFSb}{#2\mcmTitleFSa}%
  \fontsize{\the\mcmTitleFSa}{\the\mcmTitleFSb}\selectfont}

% Emit #2 only if #1 typesets to something. Measured in a parbox so that
% fields containing \\ (multi-line institutes, author lists) are legal -- and
% compared against an *empty* parbox, not against zero: an empty \parbox is
% 2.74pt tall, not 0pt, so testing >\z@ called every field non-empty and left
% the separation of each absent one behind.
\newcommand{\mcm@tifny}[2]{%
  \sbox{\mcmTitleProbeBox}{\parbox{\mcmTitleBlockWidth}{#1}}%
  \sbox{\mcmTitleEmptyBox}{\parbox{\mcmTitleBlockWidth}{}}%
  \ifdim\dimexpr\ht\mcmTitleProbeBox+\dp\mcmTitleProbeBox\relax
        >\dimexpr\ht\mcmTitleEmptyBox+\dp\mcmTitleEmptyBox\relax #2\fi}

% Height (height + depth) of a box, as a dimen expression.
\newcommand{\mcm@tboxh}[1]{\dimexpr\ht#1+\dp#1\relax}

% Typeset the title/subtitle/author/institute block at the current scale.
\newcommand{\mcm@tbuild}{%
  \sbox{\mcmTitleBlockBox}{%
    \begin{minipage}{\mcmTitleBlockWidth}%
      \raggedleft
      % Discourage hyphenation strongly (a hyphen inside an uppercase title
      % reads badly) but do not forbid it: a word longer than the block still
      % has to break somewhere, or it runs off both edges of the slide.
      \hyphenpenalty=5000\relax \exhyphenpenalty=5000\relax
      \mcm@tifny{\inserttitle}{%
        {\spaceskip=\fontdimen2\font plus \fontdimen3\font minus \fontdimen4\font
         \advance\spaceskip by \mcm@tsc{\mcmTitleWordSpacing}%
         \usebeamerfont{title}\mcm@tfs{\mcmTitleFS}{1.10}%
         \color{mcmPrimaryFg}\mcmTitleFormat{\inserttitle}\par}}%
      \mcm@tifny{\insertsubtitle}{%
        \vskip\mcm@tsc{\mcmTitleSubtitleSep}%
        {\usebeamerfont{subtitle}\mcm@tfs{\mcmSubtitleFS}{1.25}%
         \color{mcmPrimaryAccent!60!white}%
         \mcmTitleMetaFormat{\insertsubtitle}\par}}%
      \mcm@tifny{\inserttitle}{%
        \vskip\mcm@tsc{\mcmTitleRuleSep}%
        {\color{mcmPrimaryFg}%
         \rule{\mcm@tsc{\mcmTitleRuleWidth}}{\mcmTitleRuleThickness}\par}}%
      \mcm@tifny{\insertauthor}{%
        \vskip\mcm@tsc{\mcmTitleAuthorSep}%
        {\usebeamerfont{author}\mcm@tfs{\mcmAuthorFS}{1.20}%
         \color{mcmPrimaryFg}\mcmTitleMetaFormat{\insertauthor}\par}}%
      \mcm@tifny{\insertinstitute}{%
        \vskip\mcm@tsc{\mcmTitleInstituteSep}%
        {\usebeamerfont{institute}\mcm@tfs{\mcmInstituteFS}{1.30}%
         \color{mcmPrimaryFg}\mcmTitleMetaFormat{\insertinstitute}\par}}%
    \end{minipage}}%
}

% Shrink, then grow, until the block sits well in \mcmTitleAvail.
\newcommand{\mcm@tfit}{%
  \mcm@tpc=100\relax
  \mcm@tbuild
  \@mcmTitleFittrue
  \loop\if@mcmTitleFit
    \ifdim\mcm@tboxh{\mcmTitleBlockBox}>\mcmTitleAvail
      \ifnum\mcm@tpc>\mcmTitleMinScale\relax
        \advance\mcm@tpc by -4\relax \mcm@tbuild
      \else \@mcmTitleFitfalse \fi
    \else \@mcmTitleFitfalse \fi
  \repeat
  \ifnum\mcm@tpc=100\relax
    \@mcmTitleFittrue
    \loop\if@mcmTitleFit
      \ifdim\mcm@tboxh{\mcmTitleBlockBox}<\dimexpr\mcmTitleAvail*\mcmTitleFillScale/100\relax
        \ifnum\mcm@tpc<\mcmTitleMaxScale\relax
          \advance\mcm@tpc by 4\relax \mcm@tbuild
        \else \@mcmTitleFitfalse \fi
      \else \@mcmTitleFitfalse \fi
    \repeat
    % A growth step may overshoot the room; walk back until it fits again.
    \@mcmTitleFittrue
    \loop\if@mcmTitleFit
      \ifdim\mcm@tboxh{\mcmTitleBlockBox}>\mcmTitleAvail
        \advance\mcm@tpc by -4\relax \mcm@tbuild
      \else \@mcmTitleFitfalse \fi
    \repeat
  \fi}

\setbeamertemplate{title page}{%
  \global\@mcmtitlepagetrue
  \sbox{\mcmTitleGraphicBox}{\inserttitlegraphic}%
  \setlength{\mcmLogoW}{\wd\mcmTitleGraphicBox}%
  \setlength{\mcmLogoH}{\ht\mcmTitleGraphicBox}%
  \addtolength{\mcmLogoH}{\dp\mcmTitleGraphicBox}%
  \ifdim\mcmLogoW>0pt \@mcmhaslogotrue\else\@mcmhaslogofalse\fi
  %
  % Background and footer strip
  \begin{tikzpicture}[remember picture, overlay]
    \fill[mcmPrimary]
      (current page.south west) rectangle (current page.north east);
    \fill[mcmBg]
      (current page.south west)
      rectangle ([yshift=\mcmFooterHeight]current page.south east);
    \draw[line width=0.3pt, color=mcmPrimaryDark]
      ([yshift=\mcmFooterHeight]current page.south west) --
      ([yshift=\mcmFooterHeight]current page.south east);
  \end{tikzpicture}%
  %
  % Scan lines and logo, centred in the footer strip.
  % Right segments are always 0.75cm long (ending 0.3cm from the right edge).
  % The gap width adapts to the logo; the logo is centred within the gap.
  % Both gap edges use cosine-modulated rounding for an organic shape.
  \if@mcmhaslogo
    \begin{tikzpicture}[remember picture, overlay]
      \pgfmathsetlengthmacro{\rightfixed}{\paperwidth - 1.05cm}
      \pgfmathsetlengthmacro{\logocx}{\rightfixed - 0.5\mcmLogoW}
      % Place logo
      \node[anchor=center] (mcmlogo)
        at ([xshift=\logocx,
             yshift=0.5\mcmFooterHeight + \mcmLogoVOffset]current page.south west)
        {\usebox{\mcmTitleGraphicBox}};
      % Draw scan lines
      \foreach \i in {0,...,6}{%
        \pgfmathsetmacro{\imid}{3}%
        \pgfmathsetlengthmacro{\ysh}{%
          0.5\mcmFooterHeight + (\i - \imid) * \mcmLineSpacing}
        \pgfmathsetmacro{\thet}{(\i - \imid) * 3.14159 / 6}
        \pgfmathsetmacro{\cf}{abs(cos(\thet r))}
        \pgfmathsetlengthmacro{\xm}{0.25cm * (0.4 + 0.8 * \cf)}
        % Left segment
        \pgfmathsetlengthmacro{\leftend}{\logocx - 0.5\mcmLogoW - \xm}
        \draw[line width=0.5pt, color=mcmScanLine]
          ([xshift=0.3cm, yshift=\ysh]current page.south west)
            -- ([xshift=\leftend, yshift=\ysh]current page.south west);
        % Right segment
        \pgfmathsetlengthmacro{\rightstart}{\logocx + 0.5\mcmLogoW + \xm}
        \draw[line width=0.5pt, color=mcmScanLine]
          ([xshift=\rightstart, yshift=\ysh]current page.south west)
            -- ([xshift=-0.3cm, yshift=\ysh]current page.south east);
      }
    \end{tikzpicture}%
  \else
    \begin{tikzpicture}[remember picture, overlay]
      \foreach \i in {0,...,6}{%
        \pgfmathsetmacro{\imid}{3}%
        \pgfmathsetlengthmacro{\ysh}{%
          0.5\mcmFooterHeight + (\i - \imid) * \mcmLineSpacing}
        \draw[line width=0.5pt, color=mcmScanLine]
          ([xshift=0.3cm, yshift=\ysh]current page.south west)
            -- ([xshift=-0.3cm, yshift=\ysh]current page.south east);
      }
    \end{tikzpicture}%
  \fi
  %
  % Date: pinned just above the footer strip, at its nominal size (it is
  % small enough already), and its height is reserved before the main block
  % is fitted so the two can never collide.
  \global\@mcmhasdatefalse
  \sbox{\mcmTitleDateBox}{%
    \begin{minipage}{\mcmTitleBlockWidth}\raggedleft
      \mcm@tifny{\insertdate}{%
        \global\@mcmhasdatetrue
        {\usebeamerfont{date}\fontsize{\the\mcmDateFS}{1.35\mcmDateFS}\selectfont
         \color{mcmPrimaryFg}\mcmTitleMetaFormat{\insertdate}\par}}%
    \end{minipage}}%
  %
  % Room available to the title block, and the y of its floor.
  \setlength{\mcmTitleFloorH}{\mcmFooterHeight}%
  \ifdim\mcmTitleFloorH<\mcmTitleStripRef
    \setlength{\mcmTitleFloorH}{\mcmTitleStripRef}%
  \fi
  \setlength{\mcmTitleBase}{\dimexpr\mcmTitleFloorH+\mcmTitleFooterGap\relax}%
  \if@mcmhasdate
    \addtolength{\mcmTitleBase}{\dimexpr\mcm@tboxh{\mcmTitleDateBox}
                                       +\mcmTitleDateSep\relax}%
  \fi
  \setlength{\mcmTitleAvail}{\dimexpr\paperheight-\mcmTitleTopMargin
                                    -\mcmTitleBase\relax}%
  \mcm@tfit
  %
  % Placement.  The mass -- the block, its gap to the date, and the date -- is
  % centred in the empty area between the top edge and the strip, so a page
  % carries the same amount of air above the title as below the date.  (Sizing
  % and placement are separate: \mcmTitleTopMargin above bounds how *much*
  % room the mass may take, this decides where that mass sits.  Before, the
  % date was pinned to the strip and only the block was centred above it,
  % which on a dense page left roughly three times more air at the top than
  % under the date.)
  \setlength{\mcmTitleMass}{\mcm@tboxh{\mcmTitleBlockBox}}%
  \if@mcmhasdate
    \addtolength{\mcmTitleMass}{\dimexpr\mcm@tboxh{\mcmTitleDateBox}
                                       +\mcmTitleDateSep\relax}%
  \fi
  % Centred on the strip that is actually drawn (\mcmFooterHeight), not on the
  % reference height the *sizing* uses: the air must read equal above and below,
  % and the eye measures it to the strip it can see.  A shorter strip therefore
  % lowers the mass by half the difference -- but never resizes it, which is
  % what \mcmTitleStripRef is there to guarantee.
  \setlength{\mcmTitleAir}{\dimexpr0.5\paperheight-0.5\mcmFooterHeight
                                  -0.5\mcmTitleMass\relax}%
  \ifdim\mcmTitleAir<\mcmTitleTopMin
    \setlength{\mcmTitleAir}{\mcmTitleTopMin}%
  \fi
  \setlength{\mcmTitleTop}{\dimexpr\paperheight-\mcmTitleAir\relax}%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=north east, inner sep=0pt]
      at ([xshift=-\mcmTitleRightMargin, yshift=\mcmTitleTop]current page.south east)
      {\usebox{\mcmTitleBlockBox}};
    % The date travels with the block, \mcmTitleDateSep below it.
    \if@mcmhasdate
      \node[anchor=north east, inner sep=0pt]
        at ([xshift=-\mcmTitleRightMargin,
             yshift=\dimexpr\mcmTitleTop-\mcm@tboxh{\mcmTitleBlockBox}
                            -\mcmTitleDateSep\relax]current page.south east)
        {\usebox{\mcmTitleDateBox}};
    \fi
  \end{tikzpicture}%
}

\endinput
